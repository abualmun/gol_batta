{
  "name": "syncvid-frontend",
  "version": "2.0.0",
  "private": true,
  "description": "SyncVid static frontend (no build step). Dev dependencies are only for local serving and tests.",
  "type": "module",
  "scripts": {
    "start": "serve -c ../serve.json -l 5173 public",
    "vendor": "cp node_modules/socket.io-client/dist/socket.io.min.js public/vendor/socket.io.min.js",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "serve": "^14.2.6",
    "socket.io-client": "4.8.4"
  }
}
